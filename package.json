{
  "name": "mpasm-live",
  "displayName": "MPASM Live — PIC Assembly",
  "description": "PIC assembly in VS Code: MPASM and XC8 PIC-AS syntax, live diagnostics, HEX builds and flowcharts.",
  "publisher": "local",
  "version": "0.4.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Zackness/mpasm-live.git"
  },
  "homepage": "https://github.com/Zackness/mpasm-live#readme",
  "bugs": {
    "url": "https://github.com/Zackness/mpasm-live/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Education",
    "Snippets"
  ],
  "keywords": [
    "PIC",
    "PIC18F4550",
    "MPASM",
    "assembly",
    "assembler"
  ],
  "main": "./src/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onLanguage:mpasm",
    "onStartupFinished",
    "onLanguage:picas"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "El resaltado funciona; ejecutar MPASM requiere confiar en la carpeta.",
      "restrictedConfigurations": [
        "mpasm.executable",
        "picas.executable",
        "picas.devicePack"
      ]
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "MPASM necesita archivos locales y Windows."
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "package": "vsce package --allow-missing-repository",
    "check": "node --check src/core.js && node --check src/extension.js && node --check src/flowchart.js && node --check src/flowchart-panel.js && node --check src/picas.js"
  },
  "contributes": {
    "languages": [
      {
        "id": "mpasm",
        "aliases": [
          "MPASM PIC"
        ],
        "extensions": [
          ".asm",
          ".inc"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "picas",
        "aliases": [
          "PIC-AS (XC8)",
          "picas"
        ],
        "extensions": [
          ".s",
          ".S"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mpasm",
        "scopeName": "source.mpasm",
        "path": "./syntaxes/mpasm.json"
      },
      {
        "language": "picas",
        "scopeName": "source.picas",
        "path": "./syntaxes/picas.json"
      }
    ],
    "snippets": [
      {
        "language": "mpasm",
        "path": "./snippets/mpasm.json"
      },
      {
        "language": "picas",
        "path": "./snippets/picas.json"
      }
    ],
    "commands": [
      {
        "command": "mpasm.flowchart",
        "title": "MPASM: Generar diagrama de flujo",
        "icon": "$(type-hierarchy-sub)"
      },
      {
        "command": "mpasm.build",
        "title": "PIC: Ensamblar y generar HEX (MPASM / PIC-AS)"
      },
      {
        "command": "mpasm.configure",
        "title": "MPASM: Configurar ensamblador"
      },
      {
        "command": "mpasm.newPractice",
        "title": "MPASM: Crear práctica PIC18F4550"
      },
      {
        "command": "mpasm.selectMain",
        "title": "MPASM: Seleccionar archivo principal"
      },
      {
        "command": "mpasm.useActive",
        "title": "MPASM: Usar archivo activo como principal"
      },
      {
        "command": "mpasm.check",
        "title": "MPASM: Revisar código ahora"
      },
      {
        "command": "mpasm.openHex",
        "title": "MPASM: Mostrar último HEX válido"
      },
      {
        "command": "mpasm.help",
        "title": "MPASM: Guía de inicio"
      },
      {
        "command": "picas.configure",
        "title": "PIC-AS: Configurar XC8 y paquete del dispositivo"
      },
      {
        "command": "picas.build",
        "title": "PIC-AS: Ensamblar y generar HEX"
      },
      {
        "command": "picas.associate",
        "title": "PIC-AS: Activar colores para .s y .S en esta carpeta"
      },
      {
        "command": "picas.newPractice",
        "title": "PIC-AS: Crear práctica básica PIC18F4550"
      }
    ],
    "keybindings": [
      {
        "command": "mpasm.build",
        "key": "ctrl+shift+b",
        "when": "editorLangId == mpasm && isWorkspaceTrusted"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "mpasm.flowchart",
          "when": "editorLangId == mpasm || editorLangId == picas",
          "group": "navigation"
        },
        {
          "command": "mpasm.build",
          "when": "editorLangId == mpasm || editorLangId == picas",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "MPASM Live",
      "properties": {
        "mpasm.executable": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Ruta a MPASMWIN.exe. Vacío: detección automática."
        },
        "mpasm.processor": {
          "type": "string",
          "scope": "resource",
          "default": "18F4550",
          "pattern": "^(?:PIC)?[0-9A-Za-z]+$",
          "description": "Dispositivo de respaldo si LIST / PROCESSOR no lo especifica."
        },
        "mpasm.mainFile": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Archivo principal .asm/.s/.S relativo a la carpeta. Vacío: archivo activo."
        },
        "mpasm.liveChecking": {
          "type": "boolean",
          "scope": "resource",
          "default": true,
          "description": "Revisar después de una pausa al escribir."
        },
        "mpasm.delay": {
          "type": "number",
          "scope": "resource",
          "default": 900,
          "minimum": 300,
          "maximum": 10000,
          "description": "Pausa antes de revisar, en milisegundos."
        },
        "mpasm.outputDirectory": {
          "type": "string",
          "default": "build",
          "scope": "resource",
          "description": "Carpeta de salida relativa al proyecto; no puede salir del proyecto."
        },
        "mpasm.toolchain": {
          "type": "string",
          "enum": [
            "auto",
            "mpasm",
            "picas"
          ],
          "default": "auto",
          "scope": "resource",
          "description": "Auto: .s/.S usa XC8 PIC-AS; .asm usa MPASM. Puedes elegir PIC-AS para fuentes .asm migradas."
        },
        "picas.executable": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Ruta a pic-as.exe de XC8. Vacío: detectar la versión más reciente instalada."
        },
        "picas.devicePack": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Carpeta xc8 de un Device Family Pack. Vacío: detectar el paquete instalado que contiene el PIC."
        },
        "picas.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "description": "Opciones adicionales de PIC-AS, por ejemplo -Wl,-presetVec=0h. No cambia el proyecto oficial de Microchip."
        },
        "picas.sources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "description": "Fuentes adicionales .s/.S/.asm, relativas a la carpeta, para enlazar. Vacío: solo el principal."
        }
      }
    }
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
